# ============================================================
#  Amiri — панел. Нусха бигиред:  cp .env.example .env
# ============================================================

# Username-и бот (бе @) — барои тугмаи «Открыть бота» дар саҳифаи вуруд
VITE_BOT_USERNAME=amiri_expenses_bot

# Backend ҳангоми таҳия: холӣ монад, Vite худаш `/api`-ро мегузаронад.
# Барои прод суроғаи пурраи backend, масалан https://api.example.com
VITE_API_URL=

# Ба кадом суроға proxy равад (танҳо ҳангоми таҳия)
VITE_API_TARGET=http://127.0.0.1:8000

# --- танҳо барои Docker ---
# Порти ғайримаъмул, то бо nginx/сервисҳои дигари сервер бархӯрд накунад
WEB_PORT=8348
