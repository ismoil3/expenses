# ============================================================
#  Умумӣ барои ҳарду лоиҳа.
#  Ҳар лоиҳа .gitignore-и худро дорад: backend/ ва frontend/
# ============================================================

# --- Сирҳо: ҲЕҶ ГОҲ ба репозиторий намераванд ---
# Ин ҷо такрор мешавад ҳамчун тӯри эҳтиётӣ: агар .gitignore-и
# дохилӣ гум шавад, токен ҳамон тавр ба коммит намеафтад.
.env
.env.*
!.env.example
*.pem
*.key

# --- IDE ---
.vscode/
.idea/
*.swp

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- вобастагиҳо ва билд (такрори тӯри эҳтиётӣ) ---
node_modules/
dist/
.venv/
venv/
__pycache__/
*.py[cod]

# --- партови муваққатӣ ---
*.log
tmp/
